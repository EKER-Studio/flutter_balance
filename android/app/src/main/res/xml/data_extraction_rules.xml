<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app data files, database, and preferences in Android Cloud Backup (Google One) -->
        <include domain="file" path="app_flutter" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Exclude active Isar lock file and hardware-bound Keystore shared preference -->
        <exclude domain="file" path="app_flutter/balance_v1.isar.lock" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Include app data files, database, and preferences during direct device-to-device migration -->
        <include domain="file" path="app_flutter" />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="app_flutter/balance_v1.isar.lock" />
    </device-transfer>
</data-extraction-rules>
